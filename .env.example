SECRET_KEY=change-me
REQUIRE_PRACTICE_CONTEXT=true
PASSWORD_MIN_LENGTH=8
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=12
USE_MOCK_SERVICES=true

DATABASE_URL=sqlite:////mnt/disk1/tz/instance/interploop.sqlite3
UPLOAD_DIR=/mnt/disk1/tz/var/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 配置优先级：Web 覆盖 > 环境变量/.env > 默认值。
# 修改 .env 后重启后端；Web 可点击“全部恢复环境配置”解除覆盖。
# doubao 或 openai_compatible；兼容模型也使用下列 DOUBAO_* 字段。
LLM_PROVIDER=doubao
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
DOUBAO_MODEL=
LLM_TIMEOUT_SECONDS=45

# xunfei 或 openai_compatible
ASR_PROVIDER=xunfei
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1

XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_IAT_HOST=iat-api.xfyun.cn
XUNFEI_IAT_DOMAIN=iat
XUNFEI_TTS_HOST=tts-api.xfyun.cn
XUNFEI_TTS_VOICE_ZH=xiaoyan
XUNFEI_TTS_VOICE_JA=x2_yumi
# 请填写讯飞控制台中已授权的英文发音人；留空时前端自动使用浏览器英文语音。
XUNFEI_TTS_VOICE_EN=
